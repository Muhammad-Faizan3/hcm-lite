PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hcm_lite
JWT_SECRET=
# Optional one-time initial admin bootstrap. Remove these after the first successful startup.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Optional: enables the hosted-LLM assistant (without it the assistant runs in basic offline mode)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Development only: seeds demo accounts when the database has no users. Never enabled in production.
AUTO_SEED=true
TZ=Asia/Karachi
